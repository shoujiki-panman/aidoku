      "headings": [
        {
          "level": 1,
          "text": "《申請受付は終了しました》物価高対応子育て応援手当"
        },
        {
          "level": 2,
          "text": "対象者"
        },
        {
          "level": 3,
          "text": "支給対象者"
        },
        {
          "level": 3,
          "text": "対象児童"
        },
        {
          "level": 2,
          "text": "支給額"
        },
        {
          "level": 2,
          "text": "申請手続等"
        },
        {
          "level": 3,
          "text": "⑴ 令和7年9月分の児童手当を受給している方（公務員を除く）"
        },
        {
          "level": 4,
          "text": "支給日等"
        },
        {
          "level": 4,
          "text": "その他"
        },
        {
          "level": 3,
          "text": "⑵ 令和7年9月1日から令和8年3月31日までに生まれた児童（新生児）分の児童手当を受給している方（公務員を除く）"
        },
        {
          "level": 4,
          "text": "支給日等"
        },
        {
          "level": 4,
          "text": "支給を希望しない場合"
        },
        {
          "level": 4,
          "text": "その他"
        },
        {
          "level": 3,
          "text": "⑶及び⑷ 所属庁から児童手当を受給している公務員の方"
        },
        {
          "level": 4,
          "text": "申請方法"
        },
        {
          "level": 4,
          "text": "支給日等"
        },
        {
          "level": 4,
          "text": "その他"
        },
        {
          "level": 3,
          "text": "⑸ 施設に入所していた児童が令和7年10月1日以降施設を退所し、対象児童の児童手当を受給している方"
        },
        {
          "level": 4,
          "text": "支給日等"
        },
        {
          "level": 4,
          "text": "その他"
        },
        {
          "level": 3,
          "text": "⑹ 令和7年9月分の児童手当の受給者ではなかったが、配偶者からの暴力を理由に児童手当を受給している方"
        },
        {
          "level": 3,
          "text": "⑺ 令和7年9月分の児童手当の受給者ではなかったが、離婚等により児童手当の受給者になった方で配偶者と別居している方"
        },
        {
          "level": 4,
          "text": "支給日等"
        },
        {
          "level": 4,
          "text": "その他"
        },
        {
          "level": 3,
          "text": "⑻ 令和7年9月分の児童手当を受給していないが、受給要件をみたす方"
        },
        {
          "level": 4,
          "text": "支給日等"
        },
        {
          "level": 4,
          "text": "その他"
        },
        {
          "level": 2,
          "text": "注意事項"
        },
        {
          "level": 2,
          "text": "申請書等の提出先"
        },
        {
          "level": 2,
          "text": "「物価高対応子育て応援手当｣に関する“振り込め詐欺”や“個人情報の詐取”にご注意ください。"
        },
        {
          "level": 2,
          "text": "制度に関する問合せ"
        },
        {
          "level": 2,
          "text": "関連リンク"
        },
        {
          "level": 2,
          "text": "本ページに関するお問い合わせ"
        },
        {
          "level": 2,
          "text": "本ページに関するご意見をお聞かせください"
        }
      ],
