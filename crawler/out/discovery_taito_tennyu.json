        "og:url": "https://www.city.taito.lg.jp/kurashi/todokede/madoguti/shomei-copy.html"
      },
      "headings": [
        {
          "level": 1,
          "text": "区役所1階に証明書交付機を設置しています"
        },
        {
          "level": 3,
          "text": "設置場所"
        },
        {
          "level": 3,
          "text": "設置時間"
        },
        {
          "level": 3,
          "text": "発行できる証明書"
        },
        {
          "level": 3,
          "text": "発行手数料"
        },
        {
          "level": 3,
          "text": "発行手順"
        },
        {
          "level": 3,
          "text": "注意事項"
        },
        {
          "level": 5,
          "text": "・本証明書交付機は証明書発行機能のみとなります。"
        },
        {
          "level": 5,
          "text": "・他自治体の証明書は発行できません。"
        },
        {
          "level": 5,
          "text": "・お支払いは現金のみです。"
        },
        {
          "level": 5,
          "text": "・顔認証マイナンバーカードは利用できません。"
        },
        {
          "level": 5,
          "text": "・印刷不良の場合は「（1）発行された全ての証明書及び（2）領収書」と引き換えに返金いたします。必ず当日中に9番窓口までお越しください。発行当日以外の返金やご自身の選択誤りによる返金は致しかねます。"
        },
        {
          "level": 3,
          "text": "窓口開庁時間以外にも取得ができる！コンビニ交付もオススメです。"
        },
        {
          "level": 2,
          "text": "お問い合わせ"
        },
        {
          "level": 2,
          "text": "より使いやすいホームページにするためにご意見をお聞かせください。"
        },
        {
          "level": 2,
          "text": "窓口案内"
        },
        {
          "level": 2,
          "text": "厳選メニュー"
        }
