      "headings": [
        {
          "level": 1,
          "text": "住民票等の証明"
        },
        {
          "level": 2,
          "text": "窓口での請求"
        },
        {
          "level": 3,
          "text": "1 請求先及び受付時間"
        },
        {
          "level": 4,
          "text": "【請求できる方】"
        },
        {
          "level": 4,
          "text": "【請求先】"
        },
        {
          "level": 4,
          "text": "【受付時間】"
        },
        {
          "level": 3,
          "text": "2 必要なもの"
        },
        {
          "level": 4,
          "text": "【窓口に来られる方の本人確認ができる書類】"
        },
        {
          "level": 4,
          "text": "【第三者の方が窓口で請求する場合は申請理由を証明する資料】"
        },
        {
          "level": 3,
          "text": "3 住民票の取り扱い、手数料"
        },
        {
          "level": 2,
          "text": "郵送による請求"
        },
        {
          "level": 3,
          "text": "1 請求先"
        },
        {
          "level": 3,
          "text": "2 必要なもの"
        },
        {
          "level": 4,
          "text": "【住民票の写しを請求する旨の請求書（以下の事項を任意の用紙にお書きください。）】"
        },
        {
          "level": 4,
          "text": "【請求者本人を確認できる書類（有効期限内のマイナンバーカード（個人番号カード）・運転免許証・旅券（パスポート）・在留カード等のコピー）】"
        },
        {
          "level": 4,
          "text": "【第三者の方が郵送で請求する場合は申請理由を証明する資料】"
        },
        {
          "level": 4,
          "text": "【手数料＝住民票の写し1通につき300円】"
        },
        {
          "level": 4,
          "text": "【返信用封筒（あて名記入、切手貼付）】"
        },
        {
          "level": 2,
          "text": "コンビニ交付サービスでの発行"
        },
        {
          "level": 3,
          "text": "マイナンバーカードの申請方法"
        },
        {
          "level": 2,
          "text": "宿直窓口での取り次ぎによる請求"
        },
        {
          "level": 4,
          "text": "【受付時間】"
        },
        {
          "level": 4,
          "text": "【請求できる方】"
        },
        {
          "level": 4,
          "text": "【請求の流れ】"
        },
        {
          "level": 2,
          "text": "広域交付（新宿区以外の住民票）による請求"
        },
        {
          "level": 3,
          "text": "新宿区民以外の方が新宿区で住民票の写しを請求する場合"
        },
        {
          "level": 4,
          "text": "【請求できる方】"
        },
        {
          "level": 4,
          "text": "【請求先】"
        },
        {
          "level": 4,
          "text": "【受付時間】"
        },
        {
          "level": 4,
          "text": "【手数料】"
        },
        {
          "level": 4,
          "text": "【必要なもの】"
        },
        {
          "level": 4,
          "text": "【ご注意】"
        },
        {
          "level": 3,
          "text": "新宿区民の方が新宿区以外の市区町村で住民票の写しを請求する場合"
        },
        {
          "level": 2,
          "text": "本ページに関するお問い合わせ"
        },
