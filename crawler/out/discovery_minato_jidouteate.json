    {
      "url": "https://www.city.minato.tokyo.jp/kodomosoudan/20140610.html",
      "link_text": "みなと相談ねっと",
      "hops": 1,
      "score": 4,
      "parent": "https://www.city.minato.tokyo.jp/",
      "status": 200,
      "is_pdf": false,
      "text_len": 4249,
      "has_jsonld": false,
      "title": "港区ホームページ／みなと相談ねっと",
      "meta": {
        "og:title": "みなと相談ねっと",
        "og:type": "article",
        "og:description": "東京都港区ホームページです。",
        "og:url": "https://www.city.minato.tokyo.jp/kodomosoudan/20140610.html",
        "og:image": "https://www.city.minato.tokyo.jp/images/39327/kodomosoudan-logo-2.png",
        "og:site_name": "港区",
        "og:locale": "ja_jp"
      },
      "headings": [
        {
          "level": 1,
          "text": "みなと相談ねっと"
        },
        {
          "level": 2,
          "text": "こどももおとなも使える「みなと相談ねっと」があります"
        },
        {
          "level": 2,
          "text": "そうだんをするみなさんへ（こども）"
        },
        {
          "level": 4,
          "text": "電話や会って相談するには・・・"
        },
        {
          "level": 4,
          "text": "「みなと相談ねっと」の使い方"
        },
        {
          "level": 2,
          "text": "相談をするみなさんへ（おとな）"
        },
        {
          "level": 4,
          "text": "電話や会って相談するには・・・"
        },
        {
          "level": 4,
          "text": "「みなと相談ねっと」の使い方"
        },
        {
          "level": 2,
          "text": "きんきゅうの時の電話番号（こども）"
        },
        {
          "level": 5,
          "text": "（0）しせつ、相談先の名前＜話ができる方法＞"
        },
        {
          "level": 5,
          "text": "（1）港区子ども家庭支援センター＜電話＞＜会って＞"
        },
        {
          "level": 5,
          "text": "（2）港区子ども家庭支援センター＜電話＞＜会って＞"
        },
        {
          "level": 5,
          "text": "（3）港区立教育センター＜電話＞＜会って＞"
        },
        {
          "level": 5,
          "text": "（4）港区児童相談所＜電話＞"
        },
        {
          "level": 5,
          "text": "（5）東京都いじめホットライン＜電話＞"
        },
        {
          "level": 5,
          "text": "（6）24時間子供SOSダイヤル（文部科学省）＜電話＞"
        },
        {
          "level": 5,
          "text": "（7）子どもの人権110番（法務省）＜電話＞"
        },
        {
          "level": 5,
          "text": "（8）警視庁大森少年センター＜電話＞＜会って＞"
        },
        {
          "level": 5,
          "text": "（9）警視庁少年相談室ヤングテレホンコーナー＜電話＞"
        },
        {
          "level": 5,
          "text": "（10）東京若者ヘルスサポート（わかさぽ）＜電話＞"
        },
        {
          "level": 2,
          "text": "よくある質問"
        },
        {
          "level": 2,
          "text": "このページを見た人はこんなページも見ています"
        },
        {
          "level": 2,
          "text": "最近チェックしたページ"
        },
        {
          "level": 2,
          "text": "お問い合わせ"
        },
        {
          "level": 2,
          "text": "相談"
        },
        {
          "level": 2,
          "text": "Pick up"
        }
      ],
