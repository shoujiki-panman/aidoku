          "level": 3,
          "text": "郵送による申請"
        },
        {
          "level": 3,
          "text": "窓口での申請"
        },
        {
          "level": 3,
          "text": "マイナポータルでの電子申請"
        },
        {
          "level": 3,
          "text": "15日特例について（ご注意）"
        },
        {
          "level": 2,
          "text": "6.現況届"
        },
        {
          "level": 2,
          "text": "7.その他届出について"
        },
        {
          "level": 3,
          "text": "江東区外に転出する場合"
        },
        {
          "level": 3,
          "text": "受給者が海外に転出する場合"
        },
        {
          "level": 3,
          "text": "区外で別居している配偶者や児童の住所が変更した場合"
        },
        {
          "level": 3,
          "text": "ご加入されている年金が変更した場合"
        },
        {
          "level": 3,
          "text": "受給者が公務員になった場合、公務員でなくなった場合"
        },
        {
          "level": 3,
          "text": "振込口座の変更をする場合"
        },
        {
          "level": 4,
          "text": "窓口での手続き"
        },
        {
          "level": 4,
          "text": "郵送での手続き"
        },
        {
          "level": 3,
          "text": "その他"
        },
        {
          "level": 2,
          "text": "8.配偶者の暴力により江東区に避難をしている方へ"
        },
        {
          "level": 2,
          "text": "9.高校生年代の児童が入所する児童福祉施設等の設置者または高校生年代の児童を養育する里親の方へ"
        },
