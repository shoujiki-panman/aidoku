      "text_len": 3251,
      "has_jsonld": false,
      "title": "大田区ホームページ：子育てNo.1都市へ！「子育て」するならぜったい大田区",
      "meta": {
        "og:title": "子育てNo.1都市へ！「子育て」するならぜったい大田区",
        "og:type": "article",
        "og:url": "https://www.city.ota.tokyo.jp/seikatsu/kodomo/topics/kosodateprbrochure.html",
        "og:image": "/images/ogp.png"
      },
      "headings": [
        {
          "level": 1,
          "text": "子育てNo.1都市へ！「子育て」するならぜったい大田区"
        },
        {
          "level": 2,
          "text": "数字でわかる！圧倒的な住みやすさ"
        },
        {
          "level": 3,
          "text": "都内有数の公園数！570か所！"
        },
        {
          "level": 2,
          "text": "家計に直結！大田区の子育て"
        },
        {
          "level": 3,
          "text": "東京都制度"
        },
        {
          "level": 2,
          "text": "働きながら安心して子育てができるまち"
        },
        {
          "level": 3,
          "text": "毎日の「困った」を全力バックアップ！"
        },
        {
          "level": 3,
          "text": "どんな時でも安心！「預け先」と「こどもの居場所」が充実！"
        },
        {
          "level": 3,
          "text": "区内で子育てしてるママの声"
        },
        {
          "level": 2,
          "text": "特別じゃない毎日が、一番わくわくする！大田区の心地よい暮らし"
        },
        {
          "level": 3,
          "text": "圧倒的なアクセスと快適な暮らし"
        },
        {
          "level": 3,
          "text": "こどもの知的好奇心を育む教育環境と体験"
        },
        {
          "level": 3,
          "text": "文化・歴史に触れる日常"
        },
        {
          "level": 3,
          "text": "遠出しなくでも充実！大田区の休日ライフ"
        },
        {
          "level": 3,
          "text": "商店街と銭湯が育む「あたたかなつながり」"
        },
        {
          "level": 3,
          "text": "地域の力で守るこどもたちの安全"
        },
        {
          "level": 2,
          "text": "わくわくがいっぱい！家族の思い出が刻まれる「おおたの3大イベント」"
        },
        {
          "level": 3,
          "text": "私のわくわくおすすめスポット"
        },
        {
          "level": 2,
          "text": "大田区で賢く子育て！知っておきたい「3つのツール」"
        },
        {
          "level": 3,
          "text": "おおた子育ちナビHug(はぐ)くみ"
        },
        {
          "level": 3,
          "text": "子育てハンドブック（デジタル版）"
        },
        {
          "level": 3,
          "text": "大田区公式LINE"
        },
        {
          "level": 2,
          "text": "このページについて"
        },
        {
          "level": 2,
          "text": "お問い合わせ"
        },
        {
          "level": 2,
          "text": "トピックス"
        },
        {
          "level": 2,
          "text": "関連情報"
        },
        {
          "level": 2,
          "text": "大田区役所"
        }
