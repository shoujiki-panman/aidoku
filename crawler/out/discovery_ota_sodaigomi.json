      "title": "大田区ホームページ：粗大ごみ",
      "meta": {
        "og:title": "粗大ごみ",
        "og:type": "article",
        "og:url": "https://www.city.ota.tokyo.jp/seikatsu/gomi/shigentogomi/sodai.html",
        "og:image": "/images/ogp.png"
      },
      "headings": [
        {
          "level": 1,
          "text": "粗大ごみ"
        },
        {
          "level": 2,
          "text": "粗大ごみに出す前にリユース（再利用）をご検討ください。"
        },
        {
          "level": 3,
          "text": "価格を比較したい方はおいくら、地元で譲りたい方はジモティー"
        },
        {
          "level": 2,
          "text": "「おいくら」は複数のリサイクルショップに一度の依頼だけで一括査定でき、買取価格を比較して手間なく売却できるサービスです。"
        },
        {
          "level": 2,
          "text": "「ジモティー」は家具、家電などを地域内で譲り合いできる掲示板サイトです。"
        },
        {
          "level": 3,
          "text": "ジモティーの特徴"
        },
        {
          "level": 2,
          "text": "粗大ごみ"
        },
        {
          "level": 2,
          "text": "粗大ごみとは"
        },
        {
          "level": 2,
          "text": "申し込む前に"
        },
        {
          "level": 2,
          "text": "申し込み方法"
        },
        {
          "level": 3,
          "text": "電話 （受付時間：午前8時～午後7時）"
        },
        {
          "level": 3,
          "text": "インターネット （24時間受付）"
        },
        {
          "level": 3,
          "text": "お電話でお申し込みされる場合の注意事項"
        },
        {
          "level": 3,
          "text": "インターネットでお申し込みされる場合の注意事項"
        },
        {
          "level": 2,
          "text": "出し方"
        },
        {
          "level": 3,
          "text": "区の収集を希望する場合（2週間以上先の日程での受付となる場合があります）"
        },
        {
          "level": 3,
          "text": "自分で持ち込みをする場合"
        },
        {
          "level": 4,
          "text": "持ち込みにあたっての注意点"
        },
        {
          "level": 2,
          "text": "申し込み内容の確認や変更"
        },
        {
          "level": 2,
          "text": "手数料の免除"
        },
        {
          "level": 2,
          "text": "運び出し収集"
        },
        {
          "level": 2,
          "text": "このページについて"
        },
        {
          "level": 2,
          "text": "お問い合わせ"
        },
        {
          "level": 2,
          "text": "家庭から出る資源とごみ"
        },
        {
          "level": 2,
          "text": "関連情報"
        },
        {
          "level": 2,
          "text": "大田区役所"
        }
