      "title": "中央区ホームページ／住民票、マイナンバーカード等へ「旧氏」の記載を希望する方へ",
      "meta": {
        "og:title": "住民票、マイナンバーカード等へ「旧氏」の記載を希望する方へ",
        "og:type": "article",
        "og:url": "https://www.city.chuo.lg.jp/a0012/kurashi/touroku/juuminidou/user_kumin_time_20191030.html",
        "og:image": "https://www.city.chuo.lg.jp/shared/images/sns/logo.jpg",
        "og:site_name": "中央区",
        "og:locale": "ja_JP"
      },
      "headings": [
        {
          "level": 1,
          "text": "住民票、マイナンバーカード等へ「旧氏」の記載を希望する方へ"
        },
        {
          "level": 2,
          "text": "「旧氏」とは"
        },
        {
          "level": 2,
          "text": "住民票に記載できる「旧氏」の考え方"
        },
        {
          "level": 3,
          "text": "初めて「旧氏」を記載する場合"
        },
        {
          "level": 3,
          "text": "「旧氏」を変更する場合"
        },
        {
          "level": 3,
          "text": "「旧氏」を消除する場合"
        },
        {
          "level": 3,
          "text": "「旧氏」を再記載する場合"
        },
        {
          "level": 2,
          "text": "住民票に「旧氏」を記載するには"
        },
        {
          "level": 2,
          "text": "住民票に「旧氏」が記載された場合"
        },
        {
          "level": 3,
          "text": "住民票や印鑑登録証明書には必ず「旧氏」が記載されます。"
        },
        {
          "level": 3,
          "text": "「旧氏」または「旧氏の振り仮名」での印鑑登録が可能となります。"
        },
        {
          "level": 3,
          "text": "マイナンバーカードに「旧氏」および「旧氏の振り仮名」が記載されます。"
        },
        {
          "level": 2,
          "text": "「旧氏」の記載請求の届出方法"
        },
        {
          "level": 3,
          "text": "届出できる人"
        },
        {
          "level": 3,
          "text": "必要な書類"
        },
        {
          "level": 4,
          "text": "手続きをする方の本人確認書類"
        },
        {
          "level": 5,
          "text": "手続きを本人がする場合"
        },
        {
          "level": 5,
          "text": "手続きを代理人がする場合"
        },
        {
          "level": 4,
          "text": "委任状等"
        },
        {
          "level": 4,
          "text": "申請書"
        },
        {
          "level": 4,
          "text": "旧氏の振り仮名を証明する書類"
        },
        {
          "level": 3,
          "text": "受付場所等"
        },
        {
          "level": 4,
          "text": "区役所区民生活課住民記録係"
        },
        {
          "level": 4,
          "text": "日本橋・月島・晴海特別出張所区民係"
        },
        {
          "level": 2,
          "text": "お問い合わせ先"
        },
        {
          "level": 2,
          "text": "より良いウェブサイトにするためにみなさまのご意見をお聞かせください"
        }
      ],
      "date_modified": [],
      "date_published": [],
      "last_modified": null,
      "etag": null
    },
