      "headings": [
        {
          "level": 2,
          "text": "ページ番号検索"
        },
        {
          "level": 2,
          "text": "緊急情報"
        },
        {
          "level": 1,
          "text": "粗大ごみについて"
        },
        {
          "level": 2,
          "text": "粗大ごみとして出す前にリユースを検討しませんか？"
        },
        {
          "level": 2,
          "text": "粗大ごみとして出す場合"
        },
        {
          "level": 3,
          "text": "電話番号"
        },
        {
          "level": 3,
          "text": "インターネット"
        },
        {
          "level": 4,
          "text": "インターネットからのお申し込み方法"
        },
        {
          "level": 3,
          "text": "品目一覧料金表"
        },
        {
          "level": 2,
          "text": "粗大ごみの出し方"
        },
        {
          "level": 3,
          "text": "1. お申し込みになる前に"
        },
        {
          "level": 3,
          "text": "2. 「粗大ごみ受付センター」に申し込む"
        },
        {
          "level": 3,
          "text": "3. 粗大ごみ処理券を購入する"
        },
        {
          "level": 3,
          "text": "4. 粗大ごみ処理券を粗大ごみに貼って出す"
        },
        {
          "level": 3,
          "text": "5. 粗大ごみを持込する場合"
        },
        {
          "level": 4,
          "text": "指定施設（指定場所）"
        },
        {
          "level": 4,
          "text": "持込できる日時"
        },
        {
          "level": 4,
          "text": "持込の注意点"
        },
        {
          "level": 4,
          "text": "事業活動に伴って出た粗大ごみは持込できません"
        },
        {
          "level": 2,
          "text": "収集できないもの"
        },
        {
          "level": 3,
          "text": "家電リサイクル法の対象品"
        },
        {
          "level": 3,
          "text": "事業所から出る粗大ごみ"
        },
        {
          "level": 3,
          "text": "一定の大きさや重さが超えるもの"
        },
        {
          "level": 3,
          "text": "家庭で使用していたパソコン（本体・ディスプレイ）"
        },
        {
          "level": 3,
          "text": "有害性のあるもの、危険性のあるもの、著しく悪臭を発するもの"
        },
        {
          "level": 3,
          "text": "処理が困難なもの"
        },
        {
          "level": 3,
          "text": "処分場の管理又は処分作業に支障をきたすおそれのあるもの"
        },
        {
          "level": 2,
          "text": "粗大ごみの運び出し収集"
        },
        {
          "level": 3,
          "text": "運び出しの要件"
        },
        {
          "level": 3,
          "text": "注意事項"
        },
        {
          "level": 3,
          "text": "要件を満たさない場合"
        },
        {
          "level": 2,
          "text": "粗大ごみ処理手数料の減額・免除"
        },
        {
          "level": 2,
          "text": "お問い合わせ"
        },
        {
          "level": 2,
          "text": "北区役所"
        }
