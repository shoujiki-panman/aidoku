      "headings": [
        {
          "level": 1,
          "text": "粗大ごみ処理手数料のオンライン決済が始まりました"
        },
        {
          "level": 2,
          "text": "開始日"
        },
        {
          "level": 2,
          "text": "利用可能な決済方法"
        },
        {
          "level": 2,
          "text": "オンライン決済利用の粗大ごみの出し方"
        },
        {
          "level": 3,
          "text": "1粗大ごみを申し込む"
        },
        {
          "level": 4,
          "text": "インターネット申込の場合"
