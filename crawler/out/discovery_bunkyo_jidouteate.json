      "has_jsonld": false,
      "title": "児童手当 | 文京区",
      "meta": {
        "og:title": "児童手当",
        "og:type": "article",
        "og:url": "https://www.city.bunkyo.lg.jp/b022/p001469/index.html",
        "og:image": "https://www.city.bunkyo.lg.jp/shared/images/sns/logo.jpg",
        "og:site_name": "文京区",
        "og:locale": "ja_JP"
      },
      "headings": [
        {
          "level": 1,
          "text": "児童手当"
        },
        {
          "level": 2,
          "text": "児童手当の概要"
        },
        {
          "level": 3,
          "text": "支給要件"
        },
        {
          "level": 4,
          "text": "文京区在住で高校修了前（18歳に到達した日以降最初の3月31日まで）の児童を養育している父母等のうち、主に生計を維持している方(原則、所得が高い方)に支給します。"
        },
        {
          "level": 3,
          "text": "支給金額"
        },
        {
          "level": 4,
          "text": "児童一人あたりの支給月額"
        },
        {
          "level": 5,
          "text": "多子加算について"
        },
        {
          "level": 3,
          "text": "所得額について（父母のうち所得が高い者を決定する際に使用します。）"
        },
        {
          "level": 4,
          "text": "児童手当で使用する所得は、以下の所得です。"
        },
        {
          "level": 3,
          "text": "控除額一覧（父母のうち所得が高い者を決定する際に使用します。）"
        },
        {
          "level": 4,
          "text": "児童手当で使用する控除は、以下の控除です。"
        },
        {
          "level": 3,
          "text": "支給月および支給日"
        },
        {
          "level": 4,
          "text": "児童手当の定例支給日は、以下のとおりです。"
        },
        {
          "level": 3,
          "text": "所得が超過した方の再申請について（令和6年9月分までの児童手当についてのみ）"
        },
        {
          "level": 2,
          "text": "制度改正について"
        },
        {
          "level": 3,
          "text": "令和6年度制度改正について"
        },
        {
          "level": 4,
          "text": "★電子申請について★"
        },
        {
          "level": 4,
          "text": "●ご連絡事項等"
        },
        {
          "level": 4,
          "text": "●以下に該当する方は、申請が必要です。"
        },
        {
          "level": 5,
          "text": "(1)(2)に該当する方"
        },
        {
          "level": 5,
          "text": "【申請方法】"
        },
        {
          "level": 6,
          "text": "郵送の場合"
        },
        {
          "level": 6,
          "text": "電子申請の場合※マイナンバーカードをお持ちの方のみ可。"
        },
        {
          "level": 5,
          "text": "(3)に該当する方"
        },
        {
          "level": 6,
          "text": "郵送の場合"
        },
        {
          "level": 4,
          "text": "●以下に該当する方は、原則、申請不要です。（変更処理完了後『児童手当額改定決定通知書』を郵送します。）"
        },
        {
          "level": 4,
          "text": "●主な改正点について"
        },
        {
          "level": 5,
          "text": "1所得制限の撤廃"
        },
        {
          "level": 5,
          "text": "2支給対象年齢児童の拡大"
        },
        {
          "level": 5,
          "text": "3第3子以降の児童に関する支給加算額の増額"
        },
        {
          "level": 5,
          "text": "4支給月の変更(支給回数の増加)"
        },
        {
          "level": 5,
          "text": "5第3子加算対象児童の数え方(カウント方法)の変更"
        },
        {
          "level": 6,
          "text": "【例】"
        },
        {
          "level": 6,
          "text": "【制度改正前】"
        },
        {
          "level": 6,
          "text": "【制度改正後】"
        },
        {
          "level": 6,
          "text": "＜申請が必要な方＞"
        },
        {
          "level": 3,
          "text": "令和4年度制度改正について"
        },
        {
          "level": 4,
          "text": "1所得上限限度額の新設"
        },
        {
          "level": 4,
          "text": "2現況届の提出が原則不要"
        },
        {
          "level": 2,
          "text": "お問い合わせ先"
        },
        {
          "level": 2,
          "text": "より良いウェブサイトにするためにみなさまのご意見をお聞かせください。"
        },
        {
          "level": 2,
          "text": "同じ分類から探す"
        },
        {
          "level": 2,
          "text": "こちらの記事も読まれています。"
        }
      ],
